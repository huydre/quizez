# --- Postgres ---
POSTGRES_DB=quizez
POSTGRES_USER=quizez
POSTGRES_PASSWORD=quizez
POSTGRES_PORT=5432

# --- API (Spring Boot) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/quizez
SPRING_DATASOURCE_USERNAME=quizez
SPRING_DATASOURCE_PASSWORD=quizez
JWT_ISSUER=quizez
JWT_SECRET=change-me-32-byte-minimum-secret-key

# --- Web (Next.js) ---
# Browser-facing base URL (baked at build time)
NEXT_PUBLIC_API_URL=http://localhost:8080
# Server-side base URL (compose DNS)
API_URL=http://api:8080
